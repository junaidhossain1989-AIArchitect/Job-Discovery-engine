[
  {
    "id": "linkedin",
    "name": "LinkedIn Jobs",
    "searchUrlTemplate": "https://www.linkedin.com/jobs/search/?keywords={keyword}&location={location}",
    "selectors": {
      "cardContainer": "ul.jobs-search__results-list li",
      "title": "h3.base-search-card__title, a.base-card__full-link",
      "company": "h4.base-search-card__subtitle, a.hidden-nested-link",
      "location": "span.job-search-card__location",
      "link": "a.base-card__full-link",
      "description": ".show-more-less-html__markup, .description__text"
    }
  },
  {
    "id": "jora",
    "name": "Jora Australia",
    "searchUrlTemplate": "https://au.jora.com/j?q={keyword}&l={location}",
    "selectors": {
      "cardContainer": ".job-card",
      "title": ".job-title",
      "company": ".job-company",
      "location": ".job-location",
      "link": "a.job-link",
      "description": ".job-description"
    }
  }
]